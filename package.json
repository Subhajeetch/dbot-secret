{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord Bot in TypeScript",
  "main": "dist/bot.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "prebuild": "npm run clean",
    "start": "node dist/bot.js",
    "dev": "tsx src/bot.ts",
    "deploy": "tsc && node dist/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "canvas": "^3.2.2",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
